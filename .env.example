# Copy to .env and fill in from Supabase: the "Connect" button on your project page
# (Mobile Frameworks → Expo React Native), or Project Settings → Data API / API Keys.
# Use the publishable key (sb_publishable_...) or the legacy anon key (eyJ...). Both are safe to ship in the app;
# row-level security protects the data. NEVER use the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
