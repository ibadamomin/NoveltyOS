{
  "expo": {
    "name": "noveltyOS",
    "slug": "noveltyos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noveltyos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "noveltyOS uses the camera to scan product barcodes and QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F7F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.noveltyos.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "noveltyOS uses the camera to scan product barcodes and QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7F6"
        }
      ]
    ],
    "scheme": "noveltyos"
  }
}
